// Cloudflare Workers static-assets deployment for maisonthea.com.
// Workers Builds runs `npx wrangler deploy`, which uploads public/ as-is.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maisonthea",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
